# Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Opcional: ajustar ao limite de conexões do provedor; vazio mantém o padrão.
DATABASE_POOL_MAX=

# Transição de TVs antigas (sem token). Defina false somente após atualizar os players.
# Novas TVs e TVs já migradas sempre exigem token, inclusive durante a transição.
PLAYER_ALLOW_LEGACY_AUTH=true

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-secret
# Em desenvolvimento use http://localhost:3000.
# Na Vercel use a URL final do projeto.
BETTER_AUTH_URL=http://localhost:3000

# Opcional: acesso público somente para instância demonstrativa descartável.
# Estes valores entram no JavaScript enviado ao navegador.
# Todos os usuários autenticados têm acesso administrativo; não há papel demo restrito.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
